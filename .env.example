# Copy sang .env rồi điền giá trị thật. KHÔNG commit .env
# Mỗi secret phải >= 32 ký tự. Sinh nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=doi-access-secret-toi-thieu-32-ky-tu-nhe
JWT_REFRESH_SECRET=doi-refresh-secret-toi-thieu-32-ky-tu-nhe
INTERNAL_KEY=doi-internal-key-giua-api-va-parser

# open | approval | closed
REGISTRATION_MODE=approval

# ---- Chạy dev ----
PARSER_URL=http://localhost:8001
CORS_ORIGIN=http://localhost:5173
PORT=3000
DATABASE_PATH=./data/app.db

# ---- Parser ----
PARSER_PORT=8001
MAX_FILE_MB=10

# ---- Bổ sung bằng AI (tùy chọn; bỏ trống = tắt) ----
# Chuỗi dự phòng: Gemini (Google AI Studio) trước, rồi từng model free của OpenRouter.
# Provider lỗi bị tạm ngắt 2 phút để lần tải báo giá sau không phải chờ lại.
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
# Danh sách model free, phân tách bằng dấu phẩy; bỏ trống = dùng bộ mặc định
# OPENROUTER_MODELS=google/gemma-3-27b-it:free,meta-llama/llama-3.3-70b-instruct:free
AI_ATTEMPT_TIMEOUT_MS=10000
# Ngân sách thời gian cho từng bước (khách hàng / các dòng hàng), tính bằng ms
AI_BULK_DEADLINE_MS=20000
AI_LINES_DEADLINE_MS=20000
AI_LINE_CONCURRENCY=3

# ---- Tra cứu MST ra VietQR ----
# false = tắt tra cứu ngoài (chỉ dùng danh mục khách hàng)
# TAX_LOOKUP_ENABLED=true
# MST tra được (AI hoặc có sẵn trong file) nhưng chưa có trong DSKH thì tự thêm.
# Đặt false để chỉ gợi ý trên màn hình, người dùng tự bấm thêm.
# AUTO_ADD_CUSTOMER=true

# ---- Giới hạn tần suất (tùy chọn, mặc định 10/30 mỗi 15 phút) ----
# Nới khi chạy e2e/demo, KHÔNG nên nới trên production
# LOGIN_RATE_MAX=10
# AUTH_RATE_MAX=30

# ---- Chạy Docker ----
# Cổng publish ra ngoài của container api (mặc định 3000)
# CORS_ORIGIN=http://localhost:${PORT}
# SERVE_WEB=true tự bật trong image
